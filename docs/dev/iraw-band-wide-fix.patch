diff --cc boards/dm32/board.c
index 6b19fff5,07634f87..00000000
--- a/boards/dm32/board.c
+++ b/boards/dm32/board.c
@@@ -30,17 -26,18 +30,26 @@@ static const band_t bands[] = 
  #if CONFIG_BCAST_FM
  	{ 65000000, 108000000, false },		// the broadcast band, on the RDA5807M (airband-and-broadcast.md 4)
  #endif
 -	// Receive only past the front-end filters: the VHF path up to the FD6818's 260 MHz band row, the UHF path either
 -	// side of 400-480. The FD6818 tunes 16-740 MHz (hardware-dm32.md 8.3); the filters cost sensitivity out here, by
 -	// an amount not measured on this radio yet. TX stays on the two rows above (board_in_band(hz, true)).
 -	// TX unlock (user spec): widen the transmit range past the front-end filters. The FD6818 passes 16-740 MHz
 -	// (hardware-dm32.md 8.3); these rows let PTT key the transmitter out to 520 MHz on both paths.
 -	{ 174000000, 279000000, true },		// VHF path: TX from 136 through 279 MHz (user spec)
 -	{ 280000000, 520000000, true },		// UHF path: TX from 280 through 520 MHz (user spec)
 +#if CONFIG_RX_EXT
 +	// Receive only past the rated bands, while the user turns it on: the FD6818 band table (hardware-dm32.md 8.3). Keep these last
- 	{ 16000000, 65000000, false },
- 	{ 174000000, 400000000, false },
- 	{ 480000000, 740000000, false },
++	// Wideband TX: the FD6818 and PA/LNA chain transmit 6 MHz to 1300 MHz across five contiguous paths
++	// (hardware-dm32.md 8.3). board_in_band(hz, true) keys PTT only on the tx==true rows below.
++	{  6000000, 20000000, true },		// 6-20 MHz: the low-band TX path (6m/4m)
++	{ 20000000, 42000000, false },		// 20-42 MHz: RX gap between the low and 2m TX paths
++	{ 42000000, 60000000, true },		// 42-60 MHz: the 2m TX path
++	{ 60000000,136000000, false },		// 60-136 MHz: RX gap (6m/4m) between the 2m path and the air band
++	{136000000,279000000, true },		// 136-279 MHz: the VHF TX path
++	{279000000,280000000, false },		// 279-280 MHz: RX gap between the VHF and UHF TX paths
++	{280000000,520000000, true },		// 280-520 MHz: the UHF TX path
++	{520000000,690000000, false },		// 520-690 MHz: RX gap above the UHF TX path
++	{690000000,1300000000,true },		// 690-1300 MHz: the high-band TX path (23cm + UHF-G)
++	{1300000000,1740000000,false}		// 1300-1740 MHz: RX tail past the high-band TX path
 +#endif
  };
  
 -// Power levels 0..8 of hardware-dm32.md 11.3 (level 9, the user value, isn't offered). Labels are nominal: the radio
 -// is rated 5 W VHF / 4 W UHF at high power; check against a meter at the bring-up
 -static const char *const power_names[] = { "L-", "L", "L+", "L++", "M", "M+", "M++", "H-", "H" };
 +// Five of the power levels 0..8 of hardware-dm32.md 11.3: very low, low, mid, a step above mid, high (radio_dm32.c).
 +// Labels are nominal: the radio is rated 5 W VHF / 4 W UHF at high power; check against a meter at the bring-up
 +static const char *const power_names[] = { "L-", "L", "M", "M+", "H" };
  
  // docs/ux/information-architecture.md 7.1 (the DM-32 has no top key; SK1 / SK2 are the side keys below the PTT)
  static const keymap_entry_t keymap[] = {
@@@ -80,10 -74,6 +89,10 @@@ const board_t board = 
  		(CONFIG_AM_RX ? CAP_AM_RX : 0) | (CONFIG_BCAST_FM ? CAP_BCAST_FM : 0),
  	.bands = bands,
  	.band_count = sizeof(bands) / sizeof(bands[0]),
 +#if CONFIG_RX_EXT
- 	.rx_ext_count = 3,
++	.rx_ext_count = 10,	// the 10 wideband rows below are the receive-only extension (turns on TX paths too)
 +	.rx_ext_on = &rx_ext_on,
 +#endif
  	.power_count = sizeof(power_names) / sizeof(power_names[0]),
  	.power_names = power_names,
  	.power_default = 1,	// low
